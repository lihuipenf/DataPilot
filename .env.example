# 复制为 .env，并只在本地填写密钥。
DATAPILOT_PROVIDER=deepseek
DATAPILOT_TIMEOUT=45
# 整轮协作式时间预算；请求超时同时受剩余预算限制。
DATAPILOT_TURN_TIMEOUT=120
DATAPILOT_MAX_CONTEXT_CHARS=24000
DATAPILOT_MAX_TOOL_RESULT_CHARS=8000
# 默认不读取HTTP(S)_PROXY/SSL_CERT_FILE等HTTP客户端环境配置。
# 如需可信企业代理或自定义CA，可显式设true。
DATAPILOT_TRUST_ENV=false
# 配额满时拒绝新增，不自动删除已有数据。
DATAPILOT_MAX_SAVED_SESSIONS=200
DATAPILOT_MAX_SESSION_CHARTS=100
DATAPILOT_MAX_CHART_BYTES=268435456
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=45

# OpenAI 原生 Responses API；包括你的 API 账户有权访问的 Codex 模型。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.3-codex
OPENAI_BASE_URL=https://api.openai.com/v1

# Claude 原生 Messages API；BASE_URL 保留 /v1，程序会追加 /messages。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 支持工具调用的 OpenAI Chat Completions 兼容服务，例如本地 Ollama /v1。
# 不需要鉴权的本地服务可设置一个非空占位值；云服务必须填写真实密钥。
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=http://localhost:11434/v1

# 可选：默认在项目outputs下保存会话、数据和产物。容器中通过compose设置。
# DATAPILOT_OUTPUT_DIR=
# DATAPILOT_STATE_PATH=

# 可选：每百万Token的价格；留空时不估算费用。
# 同时填写两项，币种由你填写的单价决定；缓存等实际计费以服务商账单为准。
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
