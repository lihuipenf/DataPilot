        {"question": "2026-10-22 当天的销售额是多少？", "tool": "get_sales_by_date", "expected": {"daily_sales": [{"date": "2026-10-22", "sales_amount": 0}], "total_sales_amount": 0}, "answer_contains": ["2026-10-22"]},
        {"question": "Phone 的销售额是多少？", "tool": "get_sales_for_product", "expected": {"code": "product_not_found"}, "answer_contains": ["没有找到商品", "Phone"]},
        {"question": "用只读SQL查询各商品销售额", "tool": "run_readonly_sql", "unordered_rows": true, "expected": {"columns": ["product", "total_sales"], "rows": [{"product": "00123", "total_sales": 500}, {"product": "123", "total_sales": 500}, {"product": "NA", "total_sales": 0}], "truncated": false}, "answer_contains": ["3 行"]}
      ]
    }
  ]
