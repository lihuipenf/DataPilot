      "questions": [
        {"question": "哪个商品的销售额最高？", "tool": "get_top_product", "expected": {"sales_amount": 500, "tied_products": ["00123", "123"], "tied_count": 2, "tied_products_truncated": false}, "answer_contains": ["00123", "123", "500"]},
        {"question": "00123 的销售额是多少？", "tool": "get_sales_for_product", "expected": {"product": "00123", "sales_amount": 500}, "answer_contains": ["00123", "500"]},
